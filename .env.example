# Postgres connection string. Prisma CLI (prisma.config.ts) only loads .env
# (not .env.local), so this must live in .env at the project root.
#
# MUST be the POOLED connection string (Neon: host has "-pooler" in it, or
# the URL carries ?pgbouncer=true) — src/lib/prisma.ts opens one pg.Pool per
# warm serverless instance via this URL, and each instance's pool can itself
# hold several connections. On Vercel, many short-lived function instances
# can spin up under load; pointed at Neon's DIRECT endpoint instead, that
# fleet will exhaust Neon's connection limit fast. The pooled endpoint (PgBouncer
# in transaction mode) is built for exactly this fan-out.
#
# There is deliberately NO fallback if this is unset: src/lib/env.ts's
# getRuntimeEnv() throws "DATABASE_URL is not set" the moment a request
# needs the database, rather than letting `pg` silently default to
# 127.0.0.1:5432 (see node_modules/pg/lib/defaults.js) and fail with a
# confusing connection-refused error instead.
DATABASE_URL=

# The DIRECT/unpooled connection string (same database, no "-pooler"/
# pgbouncer) — used ONLY by `prisma migrate` / `db push` (prisma.config.ts),
# which need a session-level connection for advisory locks that a
# transaction pooler can't reliably provide. Never read by the running app —
# src/lib/prisma.ts only ever reads DATABASE_URL. NOT required for
# `prisma generate` either (schema-only, no connection at all).
# prisma.config.ts falls back to DATABASE_URL if this is unset, so it's
# optional for a single-connection-string setup — but on Neon, use the
# distinct direct URL here to avoid migrate hangs/failures through the pooler.
DIRECT_URL=

# Required at runtime (signs/verifies session JWTs and the guest_pass cookie
# — see src/auth.ts, src/lib/guest-pass.ts). Not read at build time.
AUTH_SECRET=
# Public base URL, used to build the QR code / join link (src/lib/qr.ts).
# Optional — defaults to http://localhost:3000 if unset, but set this in
# every real deployment or generated QR codes will point at localhost.
AUTH_URL=
# Comma-separated. Seeded as EBOARD/ACTIVE accounts by prisma/seed.ts.
INITIAL_ADMIN_EMAILS=

# Shared password for the seven hardcoded Howard NSBE officer accounts
# (prisma/seed.ts seedHardcodedAdmins) — bcrypt-hashed at seed time, never
# stored in plaintext. These seven sign in with this password and reach
# /admin directly (mustChangePassword is deliberately NOT set for them — see
# docs/DEPLOY.md for the compensating controls this requires). Falls back to
# "howard1867" if unset; override here for anything beyond local dev, and
# never commit the real value to this file.
SEED_ADMIN_PASSWORD=

# Comma-separated. Promoted to EBOARD/ACTIVE (existing accounts) or seeded as
# unclaimed EBOARD placeholders (new accounts) by prisma/seed.ts
# seedEboardEmails — the standing officer roster, separate from the seven
# hardcoded accounts above.
EBOARD_EMAILS=

# HMAC key for rotating event check-in codes (see src/lib/code.ts). Any
# non-empty secret works; rotate it and every currently-displayed code
# changes instantly. Required at runtime (first check-in-code request), not
# at build time.
CODE_SECRET=

# Set to "true" (exact string) to seed a full dev/demo season — fake members,
# events, registrations — on top of the always-safe production seed (see
# prisma/seed.ts seedFakeData). Refuses outright if NODE_ENV=production.
SEED_FAKE=

# --- File storage (member-uploaded resumes/House screenshots) ---
# Unset (or anything other than "vercel-blob") = local disk under .uploads/
# (dev only — not durable, never use in a real deployment). "vercel-blob"
# uses @vercel/blob (needs Vercel's own BLOB_READ_WRITE_TOKEN, set by Vercel
# itself when the project has a Blob store attached — nothing to set here).
STORAGE_DRIVER=

# --- Backup / season-snapshot storage (see docs/RECOVERY.md) — deliberately
# a SEPARATE driver/bucket from STORAGE_DRIVER above so backups (which hold
# every member's personal data) can never end up in the same, differently-
# permissioned place as user uploads. Unset (or anything other than "s3") =
# local disk under .backups/ (dev only). "s3" = a private S3-compatible
# bucket (real AWS S3, or an S3-compatible endpoint like Cloudflare R2) ---
BACKUP_STORAGE_DRIVER=
BACKUP_S3_BUCKET=
# Omit for real AWS S3; set for R2/other S3-compatible endpoints.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# scripts/restore-db.ts refuses to restore into anything but a localhost
# DATABASE_URL unless this is explicitly "true" — see docs/RECOVERY.md.
RESTORE_ALLOW_REMOTE=

# scripts/clear-seed-data.ts refuses to run when NODE_ENV=production unless
# this is explicitly "true" — see that script's own header comment.
CLEAR_SEED_ALLOW_PRODUCTION=
